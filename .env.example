# URL public chính thức (HTTPS, triển khai ở thư mục gốc).
# Để trống = bản xem thử noindex; không sinh canonical/sitemap chứa tên miền giả.
SITE_URL=
# Email thật để bật nút mở ứng dụng email trong phần yêu cầu tư vấn.
# Đây là thông tin public; không đặt mật khẩu hoặc API key ở đây.
VITE_CONTACT_EMAIL=
# Để trống = dùng demo đóng kèm tại /demos/an-studio/.
# Khi host An Studio riêng, điền URL HTTPS của demo rồi build lại landing page.
AN_STUDIO_DEMO_URL=

# Để trống = dùng demo đóng kèm tại /demos/orbit/.
# Khi host Orbit riêng, điền URL HTTPS mở trực tiếp ứng dụng rồi build lại CoreBrisk.
ORBIT_DEMO_URL=

# Demo Launch: landing page ô tô Aster S5. Để trống dùng /demos/aster/.
ASTER_DEMO_URL=
