{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "websheet",
    "compatibility_date": "2026-10-28",
    // Always select --env dev or --env production; the top level has no deployable assets.
    "workers_dev": false,
    "preview_urls": false,
    "env": {
        "dev": {
            "name": "websheet-dev",
            "main": "worker/index.mjs",
            "workers_dev": true,
            "preview_urls": false,
            "routes": [],
            "vars": { "MAIL_SUBJECT_PREFIX": "[DEV] " },
            "ratelimits": [{ "name": "QUOTE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
            "assets": {
                "directory": "./.output/dev/public",
                "binding": "ASSETS",
                "run_worker_first": ["/api", "/api/*"],
                "not_found_handling": "404-page"
            }
        },
        "production": {
            "name": "websheet",
            "main": "worker/index.mjs",
            "workers_dev": false,
            "preview_urls": false,
            "vars": { "MAIL_SUBJECT_PREFIX": "" },
            "ratelimits": [{ "name": "QUOTE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }],
            "routes": [
                {
                    "pattern": "websheet.shop",
                    "custom_domain": true
                }
            ],
            "assets": {
                "directory": "./.output/production/public",
                "binding": "ASSETS",
                "run_worker_first": ["/api", "/api/*"],
                "not_found_handling": "404-page"
            }
        }
    }
}
