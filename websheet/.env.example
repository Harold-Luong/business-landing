# Local development: blank = preview/noindex.
# build:dev uses .env.development; build:production uses .env.production.
# Deploy scripts pin the site URL for each environment; other public values can come from CI.
NUXT_PUBLIC_SITE_URL=https://websheet-dev.ductrong-luongnguyen.workers.dev/
NUXT_PUBLIC_CONTACT_EMAIL=ductrong.luongnguyen@gmail.com
